# Données extraites / générées (rejouables via le pipeline) — non versionnées.
data/raw/*
data/intermediate/*
data/output/*
reports/*

# Garder la structure des dossiers.
!data/raw/.gitkeep
!data/intermediate/.gitkeep
!data/output/.gitkeep
!reports/.gitkeep

# Données socles RÉELLES (open data publique) — versionnées comme référence.
!data/output/socle_national.csv
!data/output/paris/
data/output/paris/*
!data/output/paris/01_socle_paris.csv

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
build/
dist/
