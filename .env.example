# Copie ce fichier en `.env` et remplis les cles dont tu as besoin.
# `.env` est ignore par git — n'y mets jamais de secret que tu committes ensuite.

# --- Gemini : lecture native des videos YouTube (image + son, jusqu'a plusieurs heures)
# Cle gratuite : https://aistudio.google.com/apikey
# Utilise par scripts/gemini-video.py
GEMINI_API_KEY=
# Optionnel — liste les valeurs valides avec : python3 scripts/gemini-video.py --list-models
GEMINI_MODEL=gemini-2.5-flash

# --- Whisper : transcription de secours pour la skill /watch
# Uniquement necessaire quand une video n'a PAS de sous-titres natifs
# (fichiers locaux, TikTok, certains Vimeo). Les videos YouTube publiques
# passent en general par les captions gratuites, sans cle.
#
# La skill lit en priorite ~/.config/watch/.env ; ce fichier-ci sert de repli.
# Groq est prefere (moins cher, plus rapide) : https://console.groq.com/keys
GROQ_API_KEY=
# Alternative : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Reglage par defaut de /watch
# transcript | efficient | balanced | token-burner
WATCH_DETAIL=balanced
